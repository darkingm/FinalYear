# ============================================================
# Web3Market — Environment Variables Template
# ============================================================
# HƯỚNG DẪN SỬ DỤNG:
#   1. Copy file này: cp .env.example docker/.env
#   2. Điền đúng giá trị cho từng biến
#   3. KHÔNG BAO GIỜ commit file docker/.env vào git
#   4. Thêm tất cả secrets vào GitHub Secrets cho CI/CD
#
# GitHub Secrets cần thiết (Settings → Secrets → Actions):
#   DOCKERHUB_USERNAME, DOCKERHUB_TOKEN
#   HOST (VPS IP), USERNAME (root), SSH_KEY (private key)
#   Tất cả biến có giá trị thực dưới đây
# ============================================================

# ── Docker Hub ────────────────────────────────────────────────
DOCKERHUB_USERNAME=your-dockerhub-username

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=marketplace_db

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# ── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_USER=kaitojpla
RABBITMQ_PASSWORD=YOUR_RABBITMQ_PASSWORD

# ── JWT ──────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=YOUR_JWT_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_MIN_32_CHARS

# ── NextAuth ─────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_URL=https://kienai.id.vn
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET

# ── Google OAuth ─────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=946575631331-1p51ll7tpqd0bo1impek2nggoqjrcoo8.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ── Facebook OAuth ───────────────────────────────────────────
# https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=1497732641781702
FACEBOOK_CLIENT_SECRET=YOUR_FACEBOOK_CLIENT_SECRET

# ── PayPal ───────────────────────────────────────────────────
# https://developer.paypal.com/dashboard
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_SECRET=YOUR_PAYPAL_SECRET
PAYPAL_MODE=sandbox

# ── Cloudinary (Image Upload) ────────────────────────────────
# https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=deyjlti3v
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=deyjlti3v
# Unsigned upload preset for dispute evidence (create in Cloudinary dashboard)
CLOUDINARY_EVIDENCE_PRESET=marketplace_evidence

# ── Email / SMTP ─────────────────────────────────────────────
# Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_USER=YOUR_GMAIL_ADDRESS
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# ── hCaptcha ─────────────────────────────────────────────────
# https://dashboard.hcaptcha.com
HCAPTCHA_SECRET=YOUR_HCAPTCHA_SECRET_KEY

# ── Blockchain / Wallet ──────────────────────────────────────
# Private key of wallet used for escrow operations on VPS Hardhat node
# ⚠ NEVER use real mainnet wallet private key here
BLOCKCHAIN_PRIVATE_KEY=YOUR_HARDHAT_TEST_WALLET_PRIVATE_KEY

# Smart contract addresses
ESCROW_CONTRACT_LOCALHOST=0x5FbDB2315678afecb367f032d93F642f64180aa3
ESCROW_CONTRACT_POLYGON_AMOY=0xCDE08Be0190482691b3288C27240378497d74E79
RWA_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
COMPLIANCE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
RWA_MARKET_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# ── Moralis (optional — blockchain data API) ─────────────────
# https://admin.moralis.io
MORALIS_API_KEY=

# ── Inter-service Auth ───────────────────────────────────────
# Shared secret between main-api and payment-api
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SERVICE_KEY=YOUR_INTERNAL_SERVICE_KEY_MIN_32_CHARS
PAYMENT_SERVICE_URL=http://payment-api:3002

# ── AI Service (optional) ────────────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

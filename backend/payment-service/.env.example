NODE_ENV=development
PORT=3002

# Database
DATABASE_URL=postgresql://marketplace:password@localhost:5432/marketplace_db

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://marketplace:password@localhost:5672

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_MODE=sandbox

# Blockchain
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Moralis (for indexing)
MORALIS_API_KEY=your_moralis_api_key

# Private key for contract interactions
PRIVATE_KEY=your_private_key_here

# Frontend URL
FRONTEND_URL=http://localhost:3000

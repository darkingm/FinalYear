# ========================================
# E-COMMERCE DATABASE CONFIGURATION
# Copy this to .env in your project root
# ========================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=1

# Database URL (for ORMs like Prisma, Sequelize)
DATABASE_URL=postgresql://postgres:1@localhost:5433/ecommerce_db

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE=10000

# Application Settings
NODE_ENV=development
PORT=3000
API_VERSION=v1

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt Salt Rounds
BCRYPT_SALT_ROUNDS=10

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourstore.com

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/auth/microsoft/callback

# Redis Configuration (for caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# Cryptocurrency Configuration
# Blockchain Node URLs
BITCOIN_NODE_URL=https://blockchain.info
ETHEREUM_NODE_URL=https://mainnet.infura.io/v3/YOUR-PROJECT-ID
BSC_NODE_URL=https://bsc-dataseed.binance.org/

# Crypto Payment Settings
CRYPTO_PAYMENT_TIMEOUT=1800
CRYPTO_CONFIRMATION_BLOCKS_BTC=3
CRYPTO_CONFIRMATION_BLOCKS_ETH=12
CRYPTO_CONFIRMATION_BLOCKS_BSC=15

# Exchange Rate API
EXCHANGE_RATE_API_URL=https://api.coingecko.com/api/v3
EXCHANGE_RATE_CACHE_TTL=60

# System Wallet Addresses (CHANGE THESE!)
SYSTEM_BTC_WALLET=your-btc-wallet-address
SYSTEM_ETH_WALLET=your-eth-wallet-address
SYSTEM_USDT_WALLET=your-usdt-wallet-address

# Payment Gateway (Optional)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# AWS S3 (if using cloud storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Admin Dashboard URL
ADMIN_URL=http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false

# SMS Provider (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# RabbitMQ Configuration (for async tasks)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=ecommerce_exchange
RABBITMQ_QUEUE=ecommerce_queue

# Monitoring (optional)
SENTRY_DSN=your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-newrelic-key

# Feature Flags
FEATURE_CRYPTO_PAYMENTS=true
FEATURE_SOCIAL_LOGIN=true
FEATURE_REVIEWS=true
FEATURE_COUPONS=true
FEATURE_NOTIFICATIONS=true

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are currently performing maintenance. Please check back soon.

# Session Configuration
SESSION_SECRET=your-session-secret-change-this
SESSION_MAX_AGE=86400000

# Security
CSRF_SECRET=your-csrf-secret-change-this
HELMET_ENABLED=true
TRUST_PROXY=false

# Analytics (optional)
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
FACEBOOK_PIXEL_ID=your-facebook-pixel-id

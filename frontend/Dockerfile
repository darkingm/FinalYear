FROM node:22-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# === NEXT_PUBLIC_* phải được set LÚC BUILD vì Next.js bake vào JS bundle ===
ARG NEXT_PUBLIC_API_URL=https://kienai.id.vn
ARG NEXT_PUBLIC_PAYMENT_API_URL=https://kienai.id.vn/payment
ARG NEXT_PUBLIC_BINANCE_WS=wss://stream.binance.com:9443/ws
ARG NEXT_PUBLIC_HCAPTCHA_SITEKEY=fd6eea20-ea7a-42f0-8eb4-878285a04eea
ARG NEXT_PUBLIC_PAYPAL_CLIENT_ID=AYxcD1jBUgx2LMY2eoXyM
ARG NEXT_PUBLIC_POLYGON_RPC=https://polygon.drpc.org
ARG NEXT_PUBLIC_ESCROW_CONTRACT_POLYGON=0xE12c0a89be13AC13BcFBe7E749d69aa72E2515e6
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=cea17a07a0cb8c74b022c41e21294643
# ── Crypto checkout: chain + RPC + escrow (CRITICAL for VPS) ──
ARG NEXT_PUBLIC_DEFAULT_CHAIN_ID=31337
ARG NEXT_PUBLIC_TESTNET_MODE=true
ARG NEXT_PUBLIC_HARDHAT_RPC_URL=https://kienai.id.vn/rpc/hardhat
ARG NEXT_PUBLIC_ESCROW_CONTRACT_LOCALHOST=0x5FbDB2315678afecb367f032d93F642f64180aa3
ARG NEXT_PUBLIC_ESCROW_CONTRACT_POLYGON_AMOY=0xCDE08Be0190482691b3288C27240378497d74E79
ARG NEXT_PUBLIC_ESCROW_CONTRACT_BSC_TESTNET=0xE9ef77B83608b4d9834709cEb137595C1fb4E01b
ARG NEXT_PUBLIC_ESCROW_CONTRACT_BASE_SEPOLIA=0x0000000000000000000000000000000000000000
ARG NEXT_PUBLIC_RWA_MARKET_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_PAYMENT_API_URL=$NEXT_PUBLIC_PAYMENT_API_URL
ENV NEXT_PUBLIC_BINANCE_WS=$NEXT_PUBLIC_BINANCE_WS
ENV NEXT_PUBLIC_HCAPTCHA_SITEKEY=$NEXT_PUBLIC_HCAPTCHA_SITEKEY
ENV NEXT_PUBLIC_PAYPAL_CLIENT_ID=$NEXT_PUBLIC_PAYPAL_CLIENT_ID
ENV NEXT_PUBLIC_POLYGON_RPC=$NEXT_PUBLIC_POLYGON_RPC
ENV NEXT_PUBLIC_ESCROW_CONTRACT_POLYGON=$NEXT_PUBLIC_ESCROW_CONTRACT_POLYGON
ENV NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ENV NEXT_PUBLIC_DEFAULT_CHAIN_ID=$NEXT_PUBLIC_DEFAULT_CHAIN_ID
ENV NEXT_PUBLIC_TESTNET_MODE=$NEXT_PUBLIC_TESTNET_MODE
ENV NEXT_PUBLIC_HARDHAT_RPC_URL=$NEXT_PUBLIC_HARDHAT_RPC_URL
ENV NEXT_PUBLIC_ESCROW_CONTRACT_LOCALHOST=$NEXT_PUBLIC_ESCROW_CONTRACT_LOCALHOST
ENV NEXT_PUBLIC_ESCROW_CONTRACT_POLYGON_AMOY=$NEXT_PUBLIC_ESCROW_CONTRACT_POLYGON_AMOY
ENV NEXT_PUBLIC_ESCROW_CONTRACT_BSC_TESTNET=$NEXT_PUBLIC_ESCROW_CONTRACT_BSC_TESTNET
ENV NEXT_PUBLIC_ESCROW_CONTRACT_BASE_SEPOLIA=$NEXT_PUBLIC_ESCROW_CONTRACT_BASE_SEPOLIA
ENV NEXT_PUBLIC_RWA_MARKET_ESCROW_ADDRESS=$NEXT_PUBLIC_RWA_MARKET_ESCROW_ADDRESS

RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Next.js standalone output structure (built with WORKDIR /app):
#   .next/standalone/          → node_modules, package.json, etc.
#   .next/standalone/app/      → server.js (the actual app root)
#   .next/static/              → CSS/JS chunks (NOT included in standalone)
#   public/                    → static assets
#
# server.js uses __dirname as app root, so .next/static and public
# must be placed relative to server.js location (/app/app/).

# 1. Copy standalone output (includes server.js at /app/app/server.js)
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./

# 2. Copy static assets NEXT to server.js (at /app/app/.next/static/)
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./app/.next/static

# 3. Copy public assets NEXT to server.js (at /app/app/public/)
COPY --from=builder --chown=nextjs:nodejs /app/public ./app/public

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "app/server.js"]

# =====================================================
# DEVELOPMENT ENVIRONMENT - Copy this to .env.local
# =====================================================

# ==============================================
# API URLs
# ==============================================
NEXT_PUBLIC_MAIN_API_URL=http://localhost:3001
NEXT_PUBLIC_PAYMENT_API_URL=http://localhost:3002
NEXT_PUBLIC_BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# ==============================================
# NextAuth.js Configuration (REQUIRED)
# ==============================================
# Base URL của ứng dụng
NEXTAUTH_URL=http://localhost:3000

# Generate secret với command: openssl rand -base64 32
# Hoặc: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=replace_with_your_generated_secret_here

# ==============================================
# Google OAuth 2.0 (REQUIRED for Google Login)
# ==============================================
# Lấy từ: https://console.cloud.google.com/apis/credentials
# 
# Setup Steps:
# 1. Tạo project mới
# 2. Enable Google+ API
# 3. Create OAuth 2.0 Client ID
# 4. Application type: Web application
# 5. Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
# 
# Example format:
# GOOGLE_CLIENT_ID=123456789012-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==============================================
# Facebook OAuth (REQUIRED for Facebook Login)
# ==============================================
# Lấy từ: https://developers.facebook.com/apps/
# 
# Setup Steps:
# 1. Create App → Consumer type
# 2. Add Facebook Login product
# 3. Facebook Login Settings → Valid OAuth Redirect URIs: 
#    http://localhost:3000/api/auth/callback/facebook
# 4. Settings → Basic → Copy App ID và App Secret
# 
# Example format:
# FACEBOOK_CLIENT_ID=1234567890123456
# FACEBOOK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# ==============================================
# hCaptcha (REQUIRED for Registration)
# ==============================================
# Lấy từ: https://www.hcaptcha.com/
# 1. Sign up
# 2. Add new site: localhost
# 3. Copy Site Key
NEXT_PUBLIC_HCAPTCHA_SITEKEY=your_hcaptcha_sitekey_here

# ==============================================
# PayPal (REQUIRED for PayPal Payments)
# ==============================================
# Lấy từ: https://developer.paypal.com/
# 1. Log in với PayPal account
# 2. Dashboard → Apps & Credentials
# 3. Create App (Sandbox for testing)
# 4. Copy Client ID
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# ==============================================
# WalletConnect (REQUIRED for Wallet Login)
# ==============================================
# Lấy từ: https://cloud.walletconnect.com/
# 1. Sign up
# 2. Create new project
# 3. Copy Project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ==============================================
# Blockchain RPC URLs (OPTIONAL - có defaults)
# ==============================================
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-rpc.com
NEXT_PUBLIC_POLYGON_MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# ==============================================
# Smart Contract Addresses (Fill after deployment)
# ==============================================
NEXT_PUBLIC_ESCROW_CONTRACT_POLYGON=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ESCROW_CONTRACT_MUMBAI=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ESCROW_CONTRACT_ARBITRUM=0x0000000000000000000000000000000000000000

# ==============================================
# NOTES
# ==============================================
# - KHÔNG commit file .env.local vào Git
# - Mỗi developer cần tạo .env.local riêng
# - Dùng Sandbox credentials cho development
# - Dùng Production credentials cho deployment
# - Test OAuth trên http://localhost:3000/login

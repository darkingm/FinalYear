# API URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_PAYMENT_API_URL=http://localhost:3002
NEXT_PUBLIC_BINANCE_WS=wss://stream.binance.com:9443/ws

# hCaptcha
NEXT_PUBLIC_HCAPTCHA_SITEKEY=your_site_key

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_id
GOOGLE_CLIENT_SECRET=your_google_secret

# Facebook OAuth
FACEBOOK_CLIENT_ID=your_facebook_id
FACEBOOK_CLIENT_SECRET=your_facebook_secret

# PayPal (Sandbox)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_id
PAYPAL_SECRET=your_paypal_secret

# Blockchain RPC URLs
NEXT_PUBLIC_POLYGON_RPC=https://polygon.drpc.org
NEXT_PUBLIC_ARBITRUM_RPC=https://arb1.arbitrum.io/rpc

# Smart Contract Addresses
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=0x...
NEXT_PUBLIC_ESCROW_CONTRACT_POLYGON=0x...
NEXT_PUBLIC_ESCROW_CONTRACT_ARBITRUM=0x...

# WalletConnect Project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id
